{
  "name": "waxball-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end build for the WaxBall Haskell/HTMX app (TypeScript islands).",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild ts/main.ts --bundle --minify --format=esm --target=es2020 --outfile=static/js/app.js",
    "dev": "esbuild ts/main.ts --bundle --sourcemap --format=esm --target=es2020 --watch --outfile=static/js/app.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
